# Google Cloud OAuth 2.0 Credentials for OpenDriveTeX (Google Identity Services & Drive API v3)
# 1. Create a Web Application OAuth 2.0 Client ID at https://console.cloud.google.com/
# 2. Add http://localhost:5173 to "Authorized JavaScript origins"
# 3. Enable the Google Drive API and add the scope: https://www.googleapis.com/auth/drive.file

VITE_GOOGLE_CLIENT_ID=your_client_id_here.apps.googleusercontent.com
VITE_GOOGLE_API_KEY=your_api_key_here

